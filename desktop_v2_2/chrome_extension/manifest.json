{
  "manifest_version": 3,
  "name": "Shield Stream Companion",
  "version": "2.2.0",
  "minimum_chrome_version": "111",
  "description": "Deep-detect standard non-DRM media, show an IDM-style on-video quality menu, and send the chosen clear stream securely to the local Shield Stream desktop app.",
  "permissions": [
    "activeTab",
    "debugger",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shield Stream Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED",
      "match_origin_as_fallback": true
    }
  ]
}
